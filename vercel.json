{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/a/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
